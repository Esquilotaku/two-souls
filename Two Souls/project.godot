; Engine configuration file.
; Two Souls: Orion's Journey
config_version=5

[application]

config/name="Two Souls: Orion's Journey"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Uma aventura de plataforma em pixel art pela floresta de Monte Ligna."

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/size/resizable=true
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.0235294, 0.0392157, 0.101961, 1)

[physics]

2d/default_gravity=980.0
